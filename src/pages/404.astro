---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site';
const site = await getSite();
const tel = "tel:" + site.phoneHref;
---
<Base title="Page Not Found — PF Clams and Crabs" skipTarget="#main">
  <section class="section" id="main">
    <div class="container" style="text-align:center;">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p class="section-lead" style="margin:0 auto 1.6em;">Sorry, that page doesn't exist. Let's get you back to the dock.</p>
      <p>
        <a class="btn btn-primary" href="/">Back to Home</a>
        <a class="btn btn-ghost" style="margin-left:8px;" href={tel}><svg class="ico-tel" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" style="vertical-align:-.18em;margin-right:.35em"><path fill="currentColor" d="M6.6 10.9a15.5 15.5 0 0 0 6.5 6.5l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>Call {site.phone}</a>
      </p>
    </div>
  </section>
</Base>
