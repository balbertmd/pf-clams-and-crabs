/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains


# ── Caching (added 2026-07-27) ────────────────────────────────────────────────
# WHY: every deploy left the APEX serving stale HTML while *.pages.dev was already
# correct — the Cloudflare zone was edge-caching the document. It produced three
# false "it didn't ship" readings in one session and a manual Purge Everything each
# time. Revalidating HTML kills that for good; images stay cached hard because their
# filenames are stable and they are never edited in place.

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/images/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# ── 2026-08-02 correction ─────────────────────────────────────────────────────
# The assumption above — "their filenames are stable and they are never edited in
# place" — is FALSE for the brand marks. logo.png was re-cut in place twice in one
# day (palette -> RGB, then 512 -> 256). With `immutable`, different Cloudflare edge
# nodes ended up serving DIFFERENT versions of the same URL: one returned the new
# file within minutes, another was still serving the original PALETTE png hours
# later. That produced a false "the fix shipped" reading.
# Brand marks are exactly the files most likely to be re-cut, so they revalidate.
# Gallery and dock photos genuinely never change — they keep the immutable rule above.
# These come AFTER /images/* on purpose: later matching rules win.
/images/logo*.png
  Cache-Control: public, max-age=3600, must-revalidate

/images/brand/*
  Cache-Control: public, max-age=3600, must-revalidate
